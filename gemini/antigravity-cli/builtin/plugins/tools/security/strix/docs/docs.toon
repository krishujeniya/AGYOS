$schema: "https://mintlify.com/docs.json"
theme: maple
name: Strix
colors:
  primary: "#000000"
  light: "#ffffff"
  dark: "#000000"
favicon: /images/favicon-48.ico
navigation:
  tabs[2]:
    - tab, groups
    - Documentation, "{'group': 'Getting Started', 'pages': ['index', 'quickstart']}|{'group': 'Usage', 'pages': ['usage/cli', 'usage/scan-modes', 'usage/instructions', 'usage/viewer']}|{'group': 'LLM Providers', 'pages': ['llm-providers/overview', 'llm-providers/openai', 'llm-providers/anthropic', 'llm-providers/vercel-ai-gateway', 'llm-providers/openrouter', 'llm-providers/vertex', 'llm-providers/bedrock', 'llm-providers/azure', 'llm-providers/novita', 'llm-providers/local']}|{'group': 'Integrations', 'pages': ['integrations/github-actions', 'integrations/ci-cd', 'integrations/coding-agents', 'integrations/mcp']}|{'group': 'Tools', 'pages': ['tools/overview', 'tools/browser', 'tools/proxy', 'tools/terminal', 'tools/sandbox']}|{'group': 'Advanced', 'pages': ['advanced/configuration', 'advanced/skills', 'contributing']}"
    - Cloud, "{'group': 'Strix Cloud', 'pages': ['cloud/overview', 'cloud/cli']}"
  global:
    anchors[2]:
      - anchor, href, icon
      - GitHub, https://github.com/usestrix/strix, github
      - Discord, https://discord.gg/strix-ai, discord
navbar:
  links[0]:
    - (empty)
  primary:
    type: button
    label: Try Strix Cloud
    href: "https://app.strix.ai"
footer:
  socials:
    x: "https://x.com/strix_ai"
    github: "https://github.com/usestrix"
    discord: "https://discord.gg/strix-ai"
fonts:
  family: Geist
  heading:
    family: Geist
  body:
    family: Geist
appearance:
  default: dark
description: Open-source AI Hackers to secure your Apps
background:
  decoration: grid
