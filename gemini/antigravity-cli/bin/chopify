#!/usr/bin/env bash
# chopify — Headless Local AI Video Clipper CLI wrapper for AGYOS
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHOPIFY_DIR="${CHOPIFY_HOME:-${SCRIPT_DIR}/../builtin/plugins/integrations/chopify}"

if [[ ! -d "$CHOPIFY_DIR" ]]; then
    echo "Error: Chopify is not installed at ${CHOPIFY_DIR}." >&2
    exit 1
fi

PYTHON_BIN=""
for candidate in \
    "${CHOPIFY_VENV:-}/bin/python" \
    "${HOME}/.chopify/venv/bin/python" \
    "${CHOPIFY_DIR}/.venv/bin/python" \
    "${CHOPIFY_DIR}/.venv/bin/python3"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
        PYTHON_BIN="$candidate"
        break
    fi
done

run_chopify_py() {
    local script="$1"
    shift
    if command -v uv >/dev/null 2>&1; then
        if [[ -n "$PYTHON_BIN" ]]; then
            exec uv run --no-sync --python "$PYTHON_BIN" "$script" "$@"
        fi
        exec uv run --with-requirements "${CHOPIFY_DIR}/requirements.txt" "$script" "$@"
    fi
    if [[ -n "$PYTHON_BIN" ]]; then
        exec "$PYTHON_BIN" "$script" "$@"
    fi
    echo "Error: uv or a Chopify virtual environment is required." >&2
    exit 1
}

export PYTHONUNBUFFERED=1
export PYTHONPATH="${CHOPIFY_DIR}:${PYTHONPATH:-}"

case "${1:-}" in
    cli)
        shift
        run_chopify_py "${CHOPIFY_DIR}/chopify.py" "$@"
        ;;
    studio)
        shift
        run_chopify_py "${CHOPIFY_DIR}/dashboard.py" --no-browser "$@"
        ;;
    *)
        run_chopify_py "${CHOPIFY_DIR}/agent.py" "$@"
        ;;
esac

