sql_generation[1]:
  - schema, request, output
  - "users (id, name, email, created_at) orders (id, user_id, total, order_date)", Find users whose orders total more than 1000., "SELECT u.id, u.name, u.email, SUM(o.total) AS total_spent FROM users u JOIN orders o ON u.id = o.user_id GROUP BY u.id, u.name, u.email HAVING SUM(o.total) > 1000;"
