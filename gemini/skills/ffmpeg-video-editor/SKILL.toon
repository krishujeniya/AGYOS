header: "---\nname: ffmpeg-video-editor\ndescription: >-\n  Programmatic FFmpeg video editing, EDL rendering, 30ms boundary fades, PTS-shifted overlays,\n  subtitles-last compositing, two-pass -14 LUFS mastering, and ebur128/blackdetect verification.\nmetadata:\n  version: 1.1.0\n  license: MIT\nprompt-source: prompt.toon\n---\n"
