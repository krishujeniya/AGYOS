{
  "agyos-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "uv run gemini/scripts/lint_toon.py --check-path",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "uv run gemini/scripts/lint_toon.py --check-command",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "uv run gemini/scripts/lint_toon.py --lint-changed",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "uv run gemini/scripts/lint_toon.py --summary",
        "timeout": 15
      }
    ]
  },
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "write_file|edit_file",
      "command": "uv run gemini/scripts/lint_toon.py --check-path"
    },
    {
      "event": "PostToolUse",
      "matcher": "write_file|edit_file",
      "command": "uv run gemini/scripts/lint_toon.py --lint-changed"
    },
    {
      "event": "Stop",
      "command": "uv run gemini/scripts/lint_toon.py --summary"
    }
  ]
}
