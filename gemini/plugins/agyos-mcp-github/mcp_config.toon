mcpServers:
  github-remote: {'type': 'http', 'url': 'https://api.githubcopilot.com/mcp/', 'env_ref': 'AGY_GITHUB_MCP_PAT', 'tool_scope': ['pull_requests:read', 'issues:write', 'code_scanning:read', 'labels:write']}

# env_ref values resolve from GitHub Actions secrets or the operator environment.
# No cloud account identifiers are stored in this repository.
