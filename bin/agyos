#!/usr/bin/env bash
# agyos — Unified Command Line Interface for AGYOS
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

usage() {
  cat << 'EOF'
Usage: agyos <command> [arguments]

Commands:
  init        Initialize or self-repair AGYOS in this workspace
  verify      Execute the adversarial verification suite
  state       Display current milestone, active gate, and iteration
  gate <name> Transition active gate (UNDERSTAND|ANALYZE|PLAN|IMPLEMENT|VERIFY)
  compact     Execute context window compaction and reset CURRENT.md
  fast        Fast-path bypass for trivial edits (complexity <= 2 straight to IMPLEMENT)
  decide <task> Run AGYOS Decision Engine to find best skill and gate complexity
  find <query> Search 1,838+ skills in AGYOS catalog for best match
  skill <name> Display instructions and documentation for a skill
  sysinfo     Display system architecture, memory tiers, and health
  mem <tier>  Read hierarchical memory (tier0: core, tier1: recall, tier2: archival)
  intent <prompt> Compile natural language intent to TaskContract and EVPI decision
  benchmark   Run A/B benchmark evaluation across Single, Flat, and Adaptive architectures
  canary      Run pre-release canary launch gate and audit receipt generator
  rollback    Safely abort and revert the active milestone
  council     Run multi-model deliberation via Agent Council
  help        Show this help message
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  init)
    bash scripts/agyos-init.sh "$@"
    ;;
  verify)
    bash scripts/agyos-verify.sh "$@"
    ;;
  benchmark)
    python3 scripts/ab_compare_benchmark.py "$@"
    ;;
  canary)
    python3 scripts/canary_launch_gate.py "$@"
    ;;
  intent)
    query="$*"
    if [ -z "$query" ]; then
      echo "Usage: agyos intent <natural-language-prompt>" >&2
      exit 1
    fi
    python3 -c "
import json, sys
sys.path.insert(0, '.')
from agyos_decision.intent_compiler import compile_intent
from agyos_decision.evpi_clarify import evaluate_evpi

prompt = sys.argv[1]
contract = compile_intent(prompt)
decision = evaluate_evpi(prompt, contract)

print('=== AGYOS TaskContract ===')
print(json.dumps(contract.to_dict(), indent=2))
print('=== EVPI Clarification Decision ===')
print(f'Should Ask Question:  {decision.should_ask_question}')
print(f'Question:              {decision.question}')
print(f'Outbox Status:         {decision.outbox_status}')
print(f'Proceed Immediately:   {decision.proceed_immediately}')
if decision.assumptions_applied:
    print(decision.format_assumptions_header())
" "$query"
    ;;
  state)
    source bin/state.sh
    if [ "${1:-}" = "--json" ]; then
      cat .agents/state/state.json 2>/dev/null || echo "{}"
    else
      cat .agents/state/CURRENT.md 2>/dev/null || echo "No active session."
    fi
    ;;
  gate)
    target_gate="${1:-}"
    if [ -z "$target_gate" ]; then
      source bin/state.sh
      anchor_state_get "current_gate" "IDLE"
    else
      source bin/state.sh
      anchor_state_set "current_gate" "$target_gate"
      echo "Active gate transitioned to: $target_gate"
    fi
    ;;
  compact)
    bash bin/compact.sh "$@"
    ;;
  fast)
    source bin/state.sh
    anchor_state_set "current_gate" "IMPLEMENT"
    anchor_state_set "complexity_score" 1 "number"
    echo "⚡ Fast-path activated: Transitioned directly to IMPLEMENT (complexity <= 2)"
    ;;
  decide|decision)
    query="$*"
    if [ -z "$query" ]; then
      echo "Usage: agyos decide <task-description-or-keywords>" >&2
      exit 1
    fi
    python3 scripts/agyos-decision.py "$query"
    ;;
  find|search)
    query="$*"
    if [ -z "$query" ]; then
      echo "Usage: agyos find <task-description-or-keywords>" >&2
      exit 1
    fi
    json_req=$(jq -c -n --arg q "$query" '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"agyos_find_skill","arguments":{"query":$q}}}')
    echo "$json_req" | node mcp/state-server.cjs | jq -r '.result.content[0].text // .result.error // "No response"'
    ;;
  skill)
    target_skill="${1:-}"
    if [ -z "$target_skill" ]; then
      echo "Usage: agyos skill <skill-name>" >&2
      exit 1
    fi
    skill_file=".agents/skills/${target_skill}/SKILL.md"
    if [ -f "$skill_file" ]; then
      cat "$skill_file"
    else
      echo "❌ Skill not found: $target_skill" >&2
      exit 1
    fi
    ;;
  sysinfo)
    json_req='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"agyos_sys_info","arguments":{}}}'
    echo "$json_req" | node mcp/state-server.cjs | jq -r '.result.content[0].text // .result.error // "No response"'
    ;;
  mem|memory)
    tier="${1:-tier0}"
    key="${2:-}"
    action="list"
    if [ -n "$key" ]; then action="read"; fi
    json_req=$(jq -c -n --arg a "$action" --arg t "$tier" --arg k "$key" '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"agyos_memory","arguments":{"action":$a,"tier":$t,"key":$k}}}')
    echo "$json_req" | node mcp/state-server.cjs | jq -r '.result.content[0].text // .result.error // "No response"'
    ;;
  rollback)
    bash bin/rollback.sh "$@"
    ;;
  council)
    bun run scripts/council/src/council.ts "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
