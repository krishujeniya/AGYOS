schema:
  id: "schemas/receipt.toon"
  version: "1.0.0"
  type: "object"
  fields[8]:
    - name: "id"
      type: "string"
      format: "rec_*"
    - name: "task_id"
      type: "string"
    - name: "workspace_id"
      type: "string"
    - name: "actor_id"
      type: "string"
    - name: "action"
      type: "string"
    - name: "input_digest"
      type: "string"
    - name: "output_digest"
      type: "string"
    - name: "verified"
      type: "boolean"
