skill:
  id: "retrieve-context"
  home: "knowledge"
  version: "1.0.0"
  intent: "Graph-based lazy retrieval of relevant runbook sections"
  risk_level: "R0"
  department: "data_ai"
  pod: "Build"
  owner_team: "Data & AI"
  principles[4]:
    - "P06"
    - "P07"
    - "P22"
    - "P29"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute retrieve context with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute retrieve context but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "retrieve context"
    - "lazy runbook"
  clarification_triggers[1]:
    - "irrelevant context"
  abstention_triggers[1]:
    - "token blowup"
