skill:
  id: "verify-citation"
  home: "knowledge"
  version: "1.0.0"
  intent: "Validate external URLs and reference citations against primary sources"
  risk_level: "R0"
  department: "data_ai"
  pod: "Build"
  owner_team: "Data & AI"
  principles[4]:
    - "P06"
    - "P07"
    - "P22"
    - "P29"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute verify citation with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute verify citation but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "verify citation"
    - "check link"
  clarification_triggers[1]:
    - "dead citation"
  abstention_triggers[1]:
    - "hallucinated source"
