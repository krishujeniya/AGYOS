skill:
  id: "evaluate-routing"
  home: "knowledge"
  version: "1.0.0"
  intent: "Measure heuristic and model routing accuracy against held-out tests"
  risk_level: "R0"
  department: "data_ai"
  pod: "Build"
  owner_team: "Data & AI"
  principles[4]:
    - "P06"
    - "P07"
    - "P22"
    - "P29"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute evaluate routing with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute evaluate routing but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "evaluate routing"
    - "routing accuracy"
  clarification_triggers[1]:
    - "routing drift"
  abstention_triggers[1]:
    - "uncalibrated model"
