skill:
  id: "retire-skill"
  home: "knowledge"
  version: "1.0.0"
  intent: "Safely deprecate obsolete or vulnerable capabilities"
  risk_level: "R1"
  department: "data_ai"
  pod: "Build"
  owner_team: "Data & AI"
  principles[4]:
    - "P06"
    - "P07"
    - "P22"
    - "P29"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute retire skill with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute retire skill but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "retire skill"
    - "deprecate skill"
  clarification_triggers[1]:
    - "unmigrated dependent"
  abstention_triggers[1]:
    - "silent deletion"
