skill:
  id: "request-consent"
  home: "authority"
  version: "1.0.0"
  intent: "Halt execution and request explicit operator authorization for R2/R3 actions"
  risk_level: "R1"
  department: "legal_compliance"
  pod: "GNA"
  owner_team: "Legal & Compliance"
  principles[4]:
    - "P05"
    - "P09"
    - "P11"
    - "P30"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute request consent with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute request consent but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "request consent"
    - "human approval"
  clarification_triggers[1]:
    - "unclear approver"
  abstention_triggers[1]:
    - "unauthorized execute"
