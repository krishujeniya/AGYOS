skill:
  id: "expire-records"
  home: "memory"
  version: "1.0.0"
  intent: "Execute automated TTL retention pruning on ephemeral traces"
  risk_level: "R1"
  department: "data_ai"
  pod: "Build"
  owner_team: "Data & AI"
  principles[4]:
    - "P06"
    - "P09"
    - "P21"
    - "P31"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute expire records with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute expire records but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
