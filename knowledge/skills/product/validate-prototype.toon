skill:
  id: "validate-prototype"
  home: "product"
  version: "1.0.0"
  intent: "Evaluate experimental features with user feedback"
  risk_level: "R0"
  department: "product"
  pod: "Build"
  owner_team: "Product"
  principles[4]:
    - "P01"
    - "P23"
    - "P24"
    - "P28"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute validate prototype with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute validate prototype but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "validate prototype"
    - "user test"
  clarification_triggers[1]:
    - "unvalidated assumption"
  abstention_triggers[1]:
    - "premature launch"
