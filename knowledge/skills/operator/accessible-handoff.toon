skill:
  id: "accessible-handoff"
  home: "operator"
  version: "1.0.0"
  intent: "Format accessible human handoff with keyboard and screen reader support"
  risk_level: "R0"
  department: "product"
  pod: "Build"
  owner_team: "Product"
  principles[5]:
    - "P23"
    - "P24"
    - "P26"
    - "P28"
    - "P31"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute accessible handoff with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute accessible handoff but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "accessible handoff"
    - "human summary"
  clarification_triggers[1]:
    - "unclear summary"
  abstention_triggers[1]:
    - "inaccessible markup"
