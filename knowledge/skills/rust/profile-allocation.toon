skill:
  id: "profile-allocation"
  home: "rust"
  version: "1.0.0"
  intent: "Eliminate unnecessary heap allocations and buffer copies"
  risk_level: "R0"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[4]:
    - "P01"
    - "P02"
    - "P07"
    - "P12"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute profile allocation with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute profile allocation but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "profile allocation"
    - "zero copy audit"
  clarification_triggers[1]:
    - "hidden heap alloc"
  abstention_triggers[1]:
    - "memory leak"
