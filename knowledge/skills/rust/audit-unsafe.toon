skill:
  id: "audit-unsafe"
  home: "rust"
  version: "1.0.0"
  intent: "Verify zero undefined behavior in unsafe blocks"
  risk_level: "R0"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[4]:
    - "P01"
    - "P02"
    - "P07"
    - "P12"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute audit unsafe with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute audit unsafe but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "audit unsafe"
    - "miri verification"
  clarification_triggers[1]:
    - "unverified pointer"
  abstention_triggers[1]:
    - "undefined behavior"
