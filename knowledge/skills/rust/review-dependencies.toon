skill:
  id: "review-dependencies"
  home: "rust"
  version: "1.0.0"
  intent: "Enforce minimal dependency footprints and verify supply chain"
  risk_level: "R0"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[4]:
    - "P01"
    - "P02"
    - "P07"
    - "P12"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute review dependencies with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute review dependencies but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "review dependencies"
    - "cargo audit"
  clarification_triggers[1]:
    - "bloated crate"
  abstention_triggers[1]:
    - "vulnerable dep"
