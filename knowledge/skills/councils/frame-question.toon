skill:
  id: "frame-question"
  home: "councils"
  version: "1.0.0"
  intent: "Structure high-consequence dilemma into typed blind evaluation prompts"
  risk_level: "R0"
  department: "executive"
  pod: "GNA"
  owner_team: "Executive"
  principles[4]:
    - "P06"
    - "P22"
    - "P25"
    - "P27"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute frame question with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute frame question but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "frame question"
    - "council question"
  clarification_triggers[1]:
    - "loaded question"
  abstention_triggers[1]:
    - "biased premise"
