skill:
  id: "independent-review"
  home: "councils"
  version: "1.0.0"
  intent: "Execute blind multi-agent evaluation without peer bias"
  risk_level: "R0"
  department: "executive"
  pod: "GNA"
  owner_team: "Executive"
  principles[4]:
    - "P06"
    - "P22"
    - "P25"
    - "P27"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute independent review with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute independent review but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "independent review"
    - "blind evaluation"
  clarification_triggers[1]:
    - "peer influence"
  abstention_triggers[1]:
    - "collusion"
