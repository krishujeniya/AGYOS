skill:
  id: "prepare-compliance-evidence"
  home: "legal-compliance"
  version: "1.0.0"
  intent: "Compile audit-ready security and governance documentation"
  risk_level: "R0"
  department: "legal_compliance"
  pod: "GNA"
  owner_team: "Legal & Compliance"
  principles[4]:
    - "P05"
    - "P06"
    - "P07"
    - "P21"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute compliance evidence with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute compliance evidence but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "compliance evidence"
    - "audit package"
  clarification_triggers[1]:
    - "missing evidence"
  abstention_triggers[1]:
    - "forged audit record"
