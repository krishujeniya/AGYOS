skill:
  id: "triage-jurisdiction"
  home: "legal-compliance"
  version: "1.0.0"
  intent: "Identify applicable regulatory regimes like GDPR, CCPA, or HIPAA"
  risk_level: "R0"
  department: "legal_compliance"
  pod: "GNA"
  owner_team: "Legal & Compliance"
  principles[4]:
    - "P05"
    - "P06"
    - "P07"
    - "P21"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
