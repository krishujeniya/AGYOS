skill:
  id: "review-skill-intake"
  home: "protection"
  version: "1.0.0"
  intent: "Security-audit third-party skill definitions prior to admission"
  risk_level: "R0"
  department: "it_infra"
  pod: "GNA"
  owner_team: "IT & Platform"
  principles[4]:
    - "P05"
    - "P07"
    - "P20"
    - "P21"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute review skill intake with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute review skill intake but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "review skill intake"
    - "skill scan"
  clarification_triggers[1]:
    - "malicious payload"
  abstention_triggers[1]:
    - "control bypass"
