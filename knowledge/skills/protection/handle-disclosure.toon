skill:
  id: "handle-disclosure"
  home: "protection"
  version: "1.0.0"
  intent: "Execute structured incident disclosure workflows"
  risk_level: "R1"
  department: "it_infra"
  pod: "GNA"
  owner_team: "IT & Platform"
  principles[4]:
    - "P05"
    - "P07"
    - "P20"
    - "P21"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute handle disclosure with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute handle disclosure but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "handle disclosure"
    - "cve response"
  clarification_triggers[1]:
    - "uncoordinated disclosure"
  abstention_triggers[1]:
    - "coverup"
