skill:
  id: "check-invariants"
  home: "assurance"
  version: "1.0.0"
  intent: "Validate the 6 FAANG production invariants before ship"
  risk_level: "R0"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[5]:
    - "P04"
    - "P08"
    - "P09"
    - "P12"
    - "P13"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute check invariants with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute check invariants but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "check invariants"
    - "faang gate"
  clarification_triggers[1]:
    - "swallowed error"
  abstention_triggers[1]:
    - "in-place mutation"
