skill:
  id: "reserve-budget"
  home: "runtime"
  version: "1.0.0"
  intent: "Atomically reserve token, dollar, and time allowances"
  risk_level: "R1"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[5]:
    - "P04"
    - "P05"
    - "P15"
    - "P16"
    - "P32"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute reserve budget with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute reserve budget but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "reserve budget"
    - "lock allowance"
  clarification_triggers[1]:
    - "budget overdraft"
  abstention_triggers[1]:
    - "stale reservation"
