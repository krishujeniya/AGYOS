skill:
  id: "compile-intent"
  home: "runtime"
  version: "1.0.0"
  intent: "Transform natural language requests into typed TaskContracts"
  risk_level: "R0"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[5]:
    - "P04"
    - "P05"
    - "P15"
    - "P16"
    - "P32"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute compile intent with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute compile intent but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "compile intent"
    - "parse prompt"
  clarification_triggers[1]:
    - "unclear intent"
  abstention_triggers[1]:
    - "malformed prompt"
