skill:
  id: "restore-backup"
  home: "operations"
  version: "1.0.0"
  intent: "Drill disaster recovery and point-in-time data restoration"
  risk_level: "R2"
  department: "it_infra"
  pod: "GNA"
  owner_team: "IT & Platform"
  principles[7]:
    - "P12"
    - "P14"
    - "P15"
    - "P16"
    - "P17"
    - "P18"
    - "P20"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute restore backup with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute restore backup but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "restore backup"
    - "disaster recovery"
  clarification_triggers[1]:
    - "corrupt snapshot"
  abstention_triggers[1]:
    - "untested recovery"
