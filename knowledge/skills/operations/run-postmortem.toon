skill:
  id: "run-postmortem"
  home: "operations"
  version: "1.0.0"
  intent: "Author blameless incident retrospectives and action items"
  risk_level: "R0"
  department: "it_infra"
  pod: "GNA"
  owner_team: "IT & Platform"
  principles[7]:
    - "P12"
    - "P14"
    - "P15"
    - "P16"
    - "P17"
    - "P18"
    - "P20"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute run postmortem with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute run postmortem but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "run postmortem"
    - "blameless review"
  clarification_triggers[1]:
    - "punitive blame"
  abstention_triggers[1]:
    - "untracked action"
