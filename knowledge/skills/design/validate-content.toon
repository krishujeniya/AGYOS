skill:
  id: "validate-content"
  home: "design"
  version: "1.0.0"
  intent: "Ensure marketing and product copy aligns with brand voice"
  risk_level: "R0"
  department: "design"
  pod: "Build"
  owner_team: "Design"
  principles[4]:
    - "P23"
    - "P24"
    - "P26"
    - "P30"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute validate content with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute validate content but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "validate content"
    - "brand copy audit"
  clarification_triggers[1]:
    - "ai slop"
  abstention_triggers[1]:
    - "off-brand tone"
