skill:
  id: "design-interaction"
  home: "design"
  version: "1.0.0"
  intent: "Create intuitive UI layouts, components, and microcopy"
  risk_level: "R1"
  department: "design"
  pod: "Build"
  owner_team: "Design"
  principles[4]:
    - "P23"
    - "P24"
    - "P26"
    - "P30"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute design interaction with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute design interaction but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "design interaction"
    - "ui layout"
  clarification_triggers[1]:
    - "confusing ui"
  abstention_triggers[1]:
    - "inaccessible control"
