skill:
  id: "reconcile-state"
  home: "migration"
  version: "1.0.0"
  intent: "Detect and reconcile discrepancies between dual state stores"
  risk_level: "R1"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[5]:
    - "P03"
    - "P06"
    - "P09"
    - "P10"
    - "P12"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute reconcile state with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute reconcile state but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "reconcile state"
    - "dual read"
  clarification_triggers[1]:
    - "data discrepancy"
  abstention_triggers[1]:
    - "split state"
