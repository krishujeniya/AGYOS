skill:
  id: "inventory-behavior"
  home: "migration"
  version: "1.0.0"
  intent: "Map legacy entrypoints, state stores, and external adapters"
  risk_level: "R0"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[5]:
    - "P03"
    - "P06"
    - "P09"
    - "P10"
    - "P12"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute inventory behavior with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute inventory behavior but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "inventory behavior"
    - "freeze legacy"
  clarification_triggers[1]:
    - "unmapped path"
  abstention_triggers[1]:
    - "unknown dependency"
