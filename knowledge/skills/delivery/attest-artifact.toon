skill:
  id: "attest-artifact"
  home: "delivery"
  version: "1.0.0"
  intent: "Generate provenance digests and signed release receipts"
  risk_level: "R0"
  department: "it_infra"
  pod: "Build"
  owner_team: "IT & Platform"
  principles[5]:
    - "P05"
    - "P08"
    - "P11"
    - "P17"
    - "P19"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute attest artifact with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute attest artifact but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "attest artifact"
    - "artifact sha"
  clarification_triggers[1]:
    - "tampered binary"
  abstention_triggers[1]:
    - "missing digest"
