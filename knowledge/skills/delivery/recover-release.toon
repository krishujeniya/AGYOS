skill:
  id: "recover-release"
  home: "delivery"
  version: "1.0.0"
  intent: "Execute automated rollback upon canary regression"
  risk_level: "R2"
  department: "it_infra"
  pod: "Build"
  owner_team: "IT & Platform"
  principles[5]:
    - "P05"
    - "P08"
    - "P11"
    - "P17"
    - "P19"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute recover release with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute recover release but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "recover release"
    - "rollback deploy"
  clarification_triggers[1]:
    - "failed rollback"
  abstention_triggers[1]:
    - "data corruption"
