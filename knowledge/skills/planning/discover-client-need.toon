skill:
  id: "discover-client-need"
  home: "planning"
  version: "1.0.0"
  intent: "Extract business requirements and domain constraints"
  risk_level: "R0"
  department: "product"
  pod: "Build"
  owner_team: "Product"
  principles[5]:
    - "P01"
    - "P04"
    - "P09"
    - "P10"
    - "P23"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute discover need with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute discover need but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "discover need"
    - "client requirements"
  clarification_triggers[1]:
    - "unspoken expectation"
  abstention_triggers[1]:
    - "scope creep"
