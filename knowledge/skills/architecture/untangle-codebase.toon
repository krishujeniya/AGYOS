skill:
  id: "untangle-codebase"
  home: "architecture"
  version: "1.0.0"
  intent: "Decouple circular dependencies and isolate legacy side effects"
  risk_level: "R1"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[4]:
    - "P02"
    - "P03"
    - "P04"
    - "P09"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute untangle codebase with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute untangle codebase but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "untangle codebase"
    - "break circular dep"
  clarification_triggers[1]:
    - "spaghetti reference"
  abstention_triggers[1]:
    - "hidden side effect"
