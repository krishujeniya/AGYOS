skill:
  id: "design-adapter"
  home: "architecture"
  version: "1.0.0"
  intent: "Specify clean boundary abstractions for external integrations"
  risk_level: "R1"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[4]:
    - "P02"
    - "P03"
    - "P04"
    - "P09"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute design adapter with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute design adapter but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "design adapter"
    - "boundary contract"
  clarification_triggers[1]:
    - "leaky provider"
  abstention_triggers[1]:
    - "vendor lock-in"
