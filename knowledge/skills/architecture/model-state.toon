skill:
  id: "model-state"
  home: "architecture"
  version: "1.0.0"
  intent: "Formalize state machines and invariant transitions"
  risk_level: "R0"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[4]:
    - "P02"
    - "P03"
    - "P04"
    - "P09"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute model state with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute model state but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "model state"
    - "state machine"
  clarification_triggers[1]:
    - "invalid transition"
  abstention_triggers[1]:
    - "unreachable state"
