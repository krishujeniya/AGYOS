skill:
  id: "estimate-delivery"
  home: "engineering"
  version: "1.0.0"
  intent: "Produce calibrated effort estimates and risk buffers"
  risk_level: "R0"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[4]:
    - "P01"
    - "P04"
    - "P07"
    - "P08"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute estimate delivery with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute estimate delivery but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "estimate delivery"
    - "story pointing"
  clarification_triggers[1]:
    - "uncalibrated estimate"
  abstention_triggers[1]:
    - "missing risk"
