skill:
  id: "confirm-handover"
  home: "customer-success"
  version: "1.0.0"
  intent: "Validate customer satisfaction and sign off on delivered scope"
  risk_level: "R1"
  department: "customer_success"
  pod: "Customer"
  owner_team: "Customer Success"
  principles[5]:
    - "P04"
    - "P11"
    - "P23"
    - "P26"
    - "P31"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute confirm handover with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute confirm handover but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "confirm handover"
    - "client signoff"
  clarification_triggers[1]:
    - "unresolved punchlist"
  abstention_triggers[1]:
    - "premature completion"
