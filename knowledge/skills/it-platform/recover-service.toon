skill:
  id: "recover-service"
  home: "it-platform"
  version: "1.0.0"
  intent: "Execute automated failover and incident mitigation playbooks"
  risk_level: "R2"
  department: "it_infra"
  pod: "GNA"
  owner_team: "IT & Platform"
  principles[4]:
    - "P05"
    - "P07"
    - "P17"
    - "P20"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute recover service with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute recover service but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "recover service"
    - "service failover"
  clarification_triggers[1]:
    - "failed failover"
  abstention_triggers[1]:
    - "data loss"
