skill:
  id: "provision-scoped-access"
  home: "it-platform"
  version: "1.0.0"
  intent: "Grant role-based least-privilege credentials"
  risk_level: "R1"
  department: "it_infra"
  pod: "GNA"
  owner_team: "IT & Platform"
  principles[4]:
    - "P05"
    - "P07"
    - "P17"
    - "P20"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute provision scoped access with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute provision scoped access but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "provision scoped access"
    - "grant access"
  clarification_triggers[1]:
    - "excessive privilege"
  abstention_triggers[1]:
    - "unauthorized role"
