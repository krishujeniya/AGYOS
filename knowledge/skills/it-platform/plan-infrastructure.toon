skill:
  id: "plan-infrastructure"
  home: "it-platform"
  version: "1.0.0"
  intent: "Architect cloud infrastructure for resilience and cost efficiency"
  risk_level: "R0"
  department: "it_infra"
  pod: "GNA"
  owner_team: "IT & Platform"
  principles[4]:
    - "P05"
    - "P07"
    - "P17"
    - "P20"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute plan infrastructure with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute plan infrastructure but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "plan infrastructure"
    - "cloud architecture"
  clarification_triggers[1]:
    - "single point of failure"
  abstention_triggers[1]:
