skill:
  id: "canonicalize-record"
  home: "format"
  version: "1.0.0"
  intent: "Format tabular and key-value objects into canonical order"
  risk_level: "R1"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[3]:
    - "P04"
    - "P06"
    - "P13"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute canonicalize record with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute canonicalize record but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "canonicalize record"
    - "sort keys"
  clarification_triggers[1]:
    - "irregular table"
  abstention_triggers[1]:
    - "non-deterministic json"
