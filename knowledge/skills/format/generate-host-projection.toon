skill:
  id: "generate-host-projection"
  home: "format"
  version: "1.0.0"
  intent: "Emit bounded host-specific projections for CLI runtimes"
  risk_level: "R1"
  department: "engineering"
  pod: "Build"
  owner_team: "Engineering"
  principles[3]:
    - "P04"
    - "P06"
    - "P13"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute host projection with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute host projection but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "host projection"
    - "project runtime"
  clarification_triggers[1]:
    - "oversized projection"
  abstention_triggers[1]:
    - "broken schema"
