skill:
  id: "establish-evaluation-set"
  home: "data-ai"
  version: "1.0.0"
  intent: "Build curated ground-truth datasets for benchmarks"
  risk_level: "R1"
  department: "data_ai"
  pod: "Build"
  owner_team: "Data & AI"
  principles[5]:
    - "P06"
    - "P12"
    - "P21"
    - "P23"
    - "P27"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute evaluation set with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute evaluation set but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "evaluation set"
    - "ground truth"
  clarification_triggers[1]:
    - "data leakage"
  abstention_triggers[1]:
    - "biased sample"
