skill:
  id: "profile-data-quality"
  home: "data-ai"
  version: "1.0.0"
  intent: "Detect anomalies, missing fields, and distribution shifts"
  risk_level: "R0"
  department: "data_ai"
  pod: "Build"
  owner_team: "Data & AI"
  principles[5]:
    - "P06"
    - "P12"
    - "P21"
    - "P23"
    - "P27"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute profile data quality with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute profile data quality but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "profile data quality"
    - "data integrity"
  clarification_triggers[1]:
    - "dirty data"
  abstention_triggers[1]:
    - "corrupt column"
