skill:
  id: "coordinate-interviews"
  home: "people-ops"
  version: "1.0.0"
  intent: "Manage candidate scheduling and interview team handoffs"
  risk_level: "R1"
  department: "people_ops"
  pod: "People"
  owner_team: "People & Ops"
  principles[5]:
    - "P05"
    - "P06"
    - "P21"
    - "P23"
    - "P25"
  inputs[1]:
    - name: "request_payload"
      type: "string"
      required: true
  outputs[1]:
    - name: "receipt_summary"
      type: "string"
  steps[2]:
    - "Validate input boundaries, schema, and caller permissions"
    - "Execute domain action and emit verified receipt"
  fixtures:
    positive:
      prompt: "Execute coordinate interviews with verified scope"
      expected_action: "execute"
    negative:
      prompt: "Execute unauthorized or out-of-scope operation"
      expected_action: "abstain"
    interruption:
      prompt: "Execute coordinate interviews but interrupt process at checkpoint"
      expected_action: "resume_via_breadcrumb"
  route_labels[2]:
    - "coordinate interviews"
    - "schedule candidate"
  clarification_triggers[1]:
    - "scheduling conflict"
  abstention_triggers[1]:
    - "dropped candidate"
