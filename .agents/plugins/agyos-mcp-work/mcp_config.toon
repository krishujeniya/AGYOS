mcpServers:
  jira-remote: {'type': 'http', 'url': 'https://api.atlassian.com/mcp/', 'env_ref': 'AGY_JIRA_MCP_TOKEN', 'tool_scope': ['boards:read', 'sprints:read', 'issues:read']}

# env_ref values resolve from GitHub Actions secrets or the operator environment.
# No cloud account identifiers are stored in this repository.
