policy:
  id: "policy/budgets.toon"
  version: "1.0.0"
  description: "Budget Ledger Invariants and Recovery Reserve"
  rules:
    max_tokens_per_task: 30000
    max_usd_per_task: 1.50
    max_seconds_per_task: 600
    max_tool_calls_per_task: 40
    max_retries_per_task: 2
    recovery_reserve_percentage: 20
    enforce_untouchable_recovery_fund: true
